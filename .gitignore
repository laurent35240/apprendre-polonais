# Éditeurs / IDE
.idea/
.vscode/

# Config locale Claude Code (état outillage, non lié à l'app)
.claude/

# macOS
.DS_Store

# Artefacts de test
.playwright-mcp/
*.log

# Images sources brutes (avant détourage) — non versionnées, lourdes
# Volontairement HORS de public/ : ce dossier ne doit jamais entrer dans dist/.
assets/gen/

# Build et dépendances npm
node_modules/
dist/

# Caches Vite / Vitest
.vite/
coverage/

# Tests locaux visant une sauvegarde réelle hors du dépôt (données personnelles).
# La fixture anonymisée de tests/fixtures/ en est le substitut permanent en CI.
*.local.test.js
# Exports de sauvegarde, pour qu'un fichier personnel ne soit jamais committé
# par accident (le dépôt est public).
polski-zubr-sauvegarde*.json

# venv Python éventuelle
.venv/
